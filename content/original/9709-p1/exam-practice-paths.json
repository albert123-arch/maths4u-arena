  "orig_coordinate_geometry_distance_midpoint": {
    "starters": [
      {
        "id": "diameter-from-two-points",
        "title": "Recover a centre from a diameter",
        "marks": 5,
        "question": "<p>A circle has diameter \\(AB\\), where \\(A=(-5,2)\\) and \\(B=(3,8)\\).</p><ol class=\"parts\"><li>Find the length \\(AB\\). <strong>[2]</strong></li><li>Find the centre of the circle. <strong>[2]</strong></li><li>Find the squared radius. <strong>[1]</strong></li></ol>",
        "solution": "<ol class=\"parts\"><li>The coordinate changes are \\(8\\) and \\(6\\). Thus \\(AB=\\sqrt{8^2+6^2}=10\\). <strong>[2]</strong></li><li>The centre is the midpoint \\(\\left(\\frac{-5+3}{2},\\frac{2+8}{2}\\right)=(-1,5)\\). <strong>[2]</strong></li><li>The radius is \\(5\\), so its square is \\(25\\). <strong>[1]</strong></li></ol>"
      },
      {
        "id": "equal-legs-from-an-axis",
        "title": "Locate a point equidistant from two ends",
        "marks": 5,
        "question": "<p>The point \\(T\\) lies on the \\(y\\)-axis and is equidistant from \\(P(-3,2)\\) and \\(Q(5,4)\\).</p><ol class=\"parts\"><li>Find the coordinates of \\(T\\). <strong>[3]</strong></li><li>Find the exact length \\(TP\\). <strong>[2]</strong></li></ol>",
        "solution": "<ol class=\"parts\"><li>Write \\(T=(0,t)\\). Equate \\(9+(t-2)^2\\) and \\(25+(t-4)^2\\). After cancelling \\(t^2\\), \\(4t=28\\), so \\(T=(0,7)\\). <strong>[3]</strong></li><li>\\(TP=\\sqrt{3^2+5^2}=\\sqrt{34}\\). <strong>[2]</strong></li></ol>"
      }
    ],
