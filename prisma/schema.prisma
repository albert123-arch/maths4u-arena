generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum Locale {
  ru
  en
}

enum Visibility {
  PRIVATE
  PUBLIC
}

enum TaskKind {
  SHORT
  NUMERIC
  CHOICE
  MANUAL
}

enum WorkKind {
  HOMEWORK
  TEST
  PRACTICE
  OLYMPIAD
}

enum ResultPolicy {
  AFTER_SUBMIT
  AFTER_DEADLINE
  MANUAL
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum FileRole {
  STATEMENT
  HINT
  SOLUTION
  MARK_SCHEME
  TEACHER
}

enum MaterialCategory {
  UNKNOWN
  EXAM
  TRAINING
  OLYMPIAD
}

model User {
  id                   String                 @id @default(cuid())
  username             String                 @unique @db.VarChar(64)
  email                String?                @unique @db.VarChar(191)
  passwordHash         String                 @db.VarChar(255)
  displayName          String                 @db.VarChar(160)
  status               AccountStatus          @default(ACTIVE)
  createdAt            DateTime               @default(now())
  roles                UserRole[]
  profile              Profile?
  sessions             Session[]
  recoveries           RecoveryToken[]        @relation("RecoveryUser")
  issuedRecoveries     RecoveryToken[]        @relation("RecoveryIssuer")
  classes              Classroom[]
  memberships          ClassMembership[]
  tasks                Task[]
  works                Work[]
  attempts             Attempt[]
  reviews              Review[]
  olympiads            Olympiad[]
  registrations        OlympiadRegistration[]
  subscriptions        Subscription[]         @relation("Subscriber")
  grantedSubscriptions Subscription[]         @relation("GrantIssuer")
  files                StoredFile[]
  payments             Payment[]
  usage                UsageEvent[]
  audits               AuditEvent[]
  progress             LearningProgress[]
  taskBasket           TaskBasket?

  @@index([status])
}

model UserRole {
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, role])
}

model Profile {
  userId String  @id
  locale Locale  @default(ru)
  school String? @db.VarChar(191)
  grade  Int?
  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.Char(64)
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RateLimit {
  key       String   @id @db.Char(64)
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model RecoveryToken {
  id         String    @id @default(cuid())
  userId     String
  issuedById String
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  usedAt     DateTime?
  user       User      @relation("RecoveryUser", fields: [userId], references: [id], onDelete: Restrict)
  issuer     User      @relation("RecoveryIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([issuedById])
}

model Classroom {
  id         String            @id @default(cuid())
  teacherId  String
  title      String            @db.VarChar(191)
  joinCode   String            @unique @db.VarChar(24)
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  teacher    User              @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  members    ClassMembership[]
  works      Work[]

  @@index([teacherId, archivedAt])
}

model ClassMembership {
  classId   String
  userId    String
  joinedAt  DateTime  @default(now())
  removedAt DateTime?
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([classId, userId])
  @@index([userId, removedAt])
}

model Course {
  position Int @default(0)
  id         String       @id @default(cuid())
  slug       String       @unique @db.VarChar(120)
  published  Boolean      @default(false)
  featureKey String?      @db.VarChar(100)
  archivedAt DateTime?
  texts      CourseText[]
  topics     Topic[]
  feature    Feature?     @relation(fields: [featureKey], references: [key], onDelete: Restrict)
}

model CourseText {
  courseId    String
  locale      Locale
  title       String @db.VarChar(191)
  description String @db.Text
  course      Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([courseId, locale])
}

model Topic {
  id       String      @id @default(cuid())
  courseId String
  slug     String      @db.VarChar(120)
  position Int         @default(0)
  course   Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  texts    TopicText[]
  tasks    TaskTopic[]
  lessons  Lesson[]

  @@unique([courseId, slug])
}

model TopicText {
  topicId String
  locale  Locale
  title   String @db.VarChar(191)
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([topicId, locale])
}

model Lesson {
  practiceStudies PracticeStudy[]
  position Int @default(0)
  id         String             @id @default(cuid())
  topicId    String
  archivedAt DateTime?
  topic      Topic              @relation(fields: [topicId], references: [id], onDelete: Restrict)
  versions   LessonVersion[]
  progress   LearningProgress[]
  tasks      LessonTask[]

  @@index([topicId])
}

// Keep the source order within a lesson, independently of the global library.
model LessonTask {
  lessonId String
  taskId   String
  position Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@id([lessonId, taskId])
  @@index([lessonId, position])
  @@index([taskId])
}

model LessonVersion {
  id        String       @id @default(cuid())
  lessonId  String
  number    Int
  createdAt DateTime     @default(now())
  lesson    Lesson       @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  texts     LessonText[]

  @@unique([lessonId, number])
}

model LessonText {
  versionId String
  locale    Locale
  title     String        @db.VarChar(191)
  body      String        @db.LongText
  examples  String?       @db.LongText
  version   LessonVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@id([versionId, locale])
}

model LearningProgress {
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  openedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@id([userId, lessonId])
  @@index([lessonId])
}

model Source {
  id    String        @id @default(cuid())
  name  String        @unique @db.VarChar(191)
  url   String?       @db.VarChar(500)
  tasks TaskVersion[]
}

model Task {
  practiceStudies PracticeStudy[]
  id         String         @id @default(cuid())
  ownerId    String
  lessons    LessonTask[]
  visibility Visibility     @default(PRIVATE)
  featureKey String?        @db.VarChar(100)
  archivedAt DateTime?
  createdAt  DateTime       @default(now())
  owner      User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  feature    Feature?       @relation(fields: [featureKey], references: [key], onDelete: Restrict)
  versions   TaskVersion[]
  topics     TaskTopic[]
  imports    ImportRecord[]

  @@index([ownerId])
  @@index([visibility, archivedAt])
}

model TaskTopic {
  taskId  String
  topicId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Restrict)
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([taskId, topicId])
  @@index([topicId])
}

model TaskVersion {
  id             String      @id @default(cuid())
  taskId         String
  number         Int
  difficulty     Int         @default(1)
  difficultyKnown Boolean @default(false)
  materialCategory MaterialCategory @default(UNKNOWN)
  sourceId       String?
  syllabus       String?     @db.VarChar(50)
  examBoard      String?     @db.VarChar(80)
  year           Int?
  examSession    String?     @db.VarChar(50)
  paper          String?     @db.VarChar(50)
  questionNumber String?     @db.VarChar(50)
  createdAt      DateTime    @default(now())
  task           Task        @relation(fields: [taskId], references: [id], onDelete: Restrict)
  source         Source?     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  texts          TaskText[]
  parts          TaskPart[]
  assets         TaskAsset[]
  items          WorkItem[]

  @@unique([taskId, number])
  @@index([sourceId])
  @@index([syllabus, year, examSession, paper])
}

model TaskText {
  versionId   String
  locale      Locale
  title       String      @db.VarChar(191)
  statement   String      @db.LongText
  hint        String      @db.LongText
  solution    String      @db.LongText
  markScheme  String?     @db.LongText
  markSchemeSource String? @db.VarChar(500)
  teacherNote String      @db.LongText
  version     TaskVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@id([versionId, locale])
}

model TaskPart {
  id              String           @id @default(cuid())
  versionId       String
  position        Int
  kind            TaskKind
  maxPoints       Float
  caseSensitive   Boolean          @default(false)
  numericAnswer   Float?
  tolerance       Float            @default(0)
  version         TaskVersion      @relation(fields: [versionId], references: [id], onDelete: Restrict)
  texts           PartText[]
  acceptedAnswers AcceptedAnswer[]
  options         TaskOption[]
  answers         Answer[]

  @@unique([versionId, position])
}

model PartText {
  partId String
  locale Locale
  prompt String   @db.LongText
  answer String   @db.Text
  rubric String   @db.LongText
  part   TaskPart @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@id([partId, locale])
}

model AcceptedAnswer {
  id     String   @id @default(cuid())
  partId String
  value  String   @db.VarChar(1000)
  part   TaskPart @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@index([partId])
}

model TaskOption {
  id       String       @id @default(cuid())
  partId   String
  position Int
  correct  Boolean
  part     TaskPart     @relation(fields: [partId], references: [id], onDelete: Restrict)
  texts    OptionText[]

  @@unique([partId, position])
}

model OptionText {
  optionId String
  locale   Locale
  text     String     @db.Text
  option   TaskOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([optionId, locale])
}

model StoredFile {
  id           String       @id @default(cuid())
  ownerId      String
  storageKey   String       @unique @db.VarChar(100)
  originalName String       @db.VarChar(191)
  mimeType     String       @db.VarChar(100)
  size         Int
  sha256       String       @db.Char(64)
  createdAt    DateTime     @default(now())
  width        Int?
  height       Int?
  previewError String?      @db.VarChar(40)
  deletedAt    DateTime?
  derivatives FileDerivative[]
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  submissions  AnswerFile[]
  assets       TaskAsset[]

  @@index([ownerId])
}

// Original bytes alone count towards the user's quota. Every physical derivative
// is recorded here, so explicit deletion can clean up the complete upload.
model FileDerivative {
  fileId     String
  kind       String     @db.VarChar(20)
  storageKey String     @unique @db.VarChar(100)
  mimeType   String     @db.VarChar(100)
  size       Int
  width      Int
  height     Int
  sha256     String     @db.Char(64)
  file       StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([fileId, kind])
}

model TaskAsset {
  id        String      @id @default(cuid())
  versionId String
  fileId    String
  role      FileRole
  locale    Locale?
  caption   String      @db.VarChar(500)
  version   TaskVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  file      StoredFile  @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([versionId])
  @@index([fileId])
}

model Work {
  id                 String         @id @default(cuid())
  ownerId            String
  classId            String?
  title              String         @db.VarChar(191)
  kind               WorkKind
  archivedAt         DateTime?
  resultsPublishedAt DateTime?
  createdAt          DateTime       @default(now())
  owner              User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  classroom          Classroom?     @relation(fields: [classId], references: [id], onDelete: Restrict)
  versions           WorkVersion[]
  round              OlympiadRound?

  @@index([ownerId, archivedAt])
  @@index([classId])
}

model WorkVersion {
  id               String       @id @default(cuid())
  workId           String
  number           Int          @default(1)
  opensAt          DateTime
  dueAt            DateTime
  timeLimitSeconds Int?
  attemptsAllowed  Int          @default(1)
  resultPolicy     ResultPolicy @default(MANUAL)
  revealSolutions  Boolean      @default(false)
  allowFiles       Boolean      @default(true)
  publishedAt      DateTime     @default(now())
  work             Work         @relation(fields: [workId], references: [id], onDelete: Restrict)
  items            WorkItem[]
  attempts         Attempt[]

  @@unique([workId, number])
  @@index([dueAt])
}

model WorkItem {
  id            String      @id @default(cuid())
  workVersionId String
  taskVersionId String
  position      Int
  maxPoints     Float
  workVersion   WorkVersion @relation(fields: [workVersionId], references: [id], onDelete: Restrict)
  taskVersion   TaskVersion @relation(fields: [taskVersionId], references: [id], onDelete: Restrict)

  @@unique([workVersionId, taskVersionId])
  @@unique([workVersionId, position])
  @@index([taskVersionId])
}

model Attempt {
  study PracticeStudy?
  id            String        @id @default(cuid())
  workVersionId String
  userId        String
  number        Int
  status        AttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  expiresAt     DateTime
  submittedAt   DateTime?
  gradedAt      DateTime?
  timedOut      Boolean       @default(false)
  revision      Int           @default(0)
  workVersion   WorkVersion   @relation(fields: [workVersionId], references: [id], onDelete: Restrict)
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers       Answer[]

  @@unique([workVersionId, userId, number])
  @@index([userId, status])
  @@index([status, expiresAt])
}

model Answer {
  id            String         @id @default(cuid())
  attemptId     String
  partId        String
  response      Json
  autoPoints    Float?
  savedAt       DateTime       @default(now())
  attempt       Attempt        @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  part          TaskPart       @relation(fields: [partId], references: [id], onDelete: Restrict)
  review        Review?
  aiSuggestions AiSuggestion[]
  files         AnswerFile[]

  @@unique([attemptId, partId])
  @@index([partId])
}

model Review {
  id         String   @id @default(cuid())
  answerId   String   @unique
  reviewerId String
  points     Float?
  revision   Int      @default(0)
  comment    String   @db.Text
  reviewedAt DateTime @default(now())
  answer     Answer   @relation(fields: [answerId], references: [id], onDelete: Restrict)
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([reviewerId])
}

model AnswerFile {
  answerId String
  fileId   String     @unique
  answer   Answer     @relation(fields: [answerId], references: [id], onDelete: Restrict)
  file     StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([answerId, fileId])
}

model AiSuggestion {
  id             String   @id @default(cuid())
  answerId       String
  provider       String   @db.VarChar(100)
  model          String   @db.VarChar(100)
  proposedPoints Float?
  feedback       String   @db.Text
  externalData   Json?
  createdAt      DateTime @default(now())
  answer         Answer   @relation(fields: [answerId], references: [id], onDelete: Restrict)

  @@index([answerId])
}

model Olympiad {
  id                   String                 @id @default(cuid())
  organizerId          String
  title                String                 @db.VarChar(191)
  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  archivedAt           DateTime?
  organizer            User                   @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  groups               AgeGroup[]
  rounds               OlympiadRound[]
  registrations        OlympiadRegistration[]

  @@index([organizerId])
}

model AgeGroup {
  id            String                 @id @default(cuid())
  olympiadId    String
  title         String                 @db.VarChar(100)
  minAge        Int
  maxAge        Int
  olympiad      Olympiad               @relation(fields: [olympiadId], references: [id], onDelete: Restrict)
  registrations OlympiadRegistration[]
  rounds        OlympiadRound[]

  @@unique([olympiadId, title])
}

model OlympiadRegistration {
  olympiadId   String
  userId       String
  groupId      String
  age          Int
  registeredAt DateTime  @default(now())
  withdrawnAt  DateTime?
  olympiad     Olympiad  @relation(fields: [olympiadId], references: [id], onDelete: Restrict)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  group        AgeGroup  @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([olympiadId, userId])
  @@index([userId])
  @@index([groupId])
}

model OlympiadRound {
  id         String   @id @default(cuid())
  olympiadId String
  groupId    String
  workId     String   @unique
  number     Int
  olympiad   Olympiad @relation(fields: [olympiadId], references: [id], onDelete: Restrict)
  group      AgeGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  work       Work     @relation(fields: [workId], references: [id], onDelete: Restrict)

  @@unique([olympiadId, groupId, number])
  @@index([groupId])
}

model Feature {
  key     String        @id @db.VarChar(100)
  title   String        @db.VarChar(191)
  plans   PlanFeature[]
  courses Course[]
  tasks   Task[]
  usage   UsageEvent[]
}

model Plan {
  id            String         @id @default(cuid())
  name          String         @unique @db.VarChar(100)
  active        Boolean        @default(true)
  features      PlanFeature[]
  subscriptions Subscription[]
}

model PlanFeature {
  planId     String
  featureKey String  @db.VarChar(100)
  usageLimit Int?
  plan       Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  feature    Feature @relation(fields: [featureKey], references: [key], onDelete: Restrict)

  @@id([planId, featureKey])
  @@index([featureKey])
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String
  planId      String
  grantedById String?
  status      SubscriptionStatus @default(ACTIVE)
  startsAt    DateTime
  endsAt      DateTime
  reason      String             @db.VarChar(500)
  user        User               @relation("Subscriber", fields: [userId], references: [id], onDelete: Restrict)
  plan        Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  grantedBy   User?              @relation("GrantIssuer", fields: [grantedById], references: [id], onDelete: Restrict)
  payments    Payment[]

  @@index([userId, status, endsAt])
  @@index([planId])
  @@index([grantedById])
}

model Payment {
  id             String         @id @default(cuid())
  userId         String
  subscriptionId String?
  provider       String         @db.VarChar(100)
  externalId     String         @db.VarChar(191)
  amountMinor    Int
  currency       String         @db.Char(3)
  status         String         @db.VarChar(40)
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  events         PaymentEvent[]

  @@unique([provider, externalId])
  @@index([userId])
  @@index([subscriptionId])
}

model PaymentEvent {
  id              String    @id @default(cuid())
  provider        String    @db.VarChar(100)
  externalEventId String    @db.VarChar(191)
  paymentId       String?
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  payment         Payment?  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, externalEventId])
  @@index([paymentId])
}

model UsageEvent {
  id         String   @id @default(cuid())
  userId     String
  featureKey String   @db.VarChar(100)
  units      Int
  requestKey String   @unique @db.VarChar(191)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  feature    Feature  @relation(fields: [featureKey], references: [key], onDelete: Restrict)

  @@index([userId, featureKey, createdAt])
  @@index([featureKey])
}

model ImportRecord {
  id            String   @id @default(cuid())
  sourceProject String   @db.VarChar(50)
  legacyId      String   @db.VarChar(191)
  taskId        String
  contentHash   String   @db.Char(64)
  importedAt    DateTime @default(now())
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([sourceProject, legacyId])
  @@index([taskId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String
  action    String   @db.VarChar(100)
  targetId  String   @db.VarChar(191)
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetId])
}

model TaskBasket {
  userId String @id
  taskIds Json
  revision Int @default(0)
  updatedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model PracticeStudy {
  attemptId String @id
  taskId String
  lessonId String?
  hintAt DateTime?
  answerAt DateTime?
  solutionAt DateTime?
  markSchemeAt DateTime?
  selfCheckedAt DateTime?
  needsRepeat Boolean @default(false)
  updatedAt DateTime @default(now())
  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  @@index([lessonId, taskId])
  @@index([taskId])
}
