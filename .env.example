# Explicit new Maths4U database only. Legacy DATABASE_URL and DB_* are ignored.
MATHS4U_ENV="development"
MATHS4U_DATABASE_NAME="maths4u_dev"
MATHS4U_DATABASE_URL="mysql://USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/maths4u_dev"
APP_URL="http://localhost:3000"
# Absolute directory, outside public, persisted across releases.
PRIVATE_STORAGE_PATH="D:/www/arena/storage/private"
# Optional, only for first-admin creation; set privately. No default password.
# NEW_ADMIN_USERNAME=
# NEW_ADMIN_PASSWORD=
# NEW_ADMIN_NAME=
